{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",        // ✅ dist로 통일
    "noEmit": false,
    "rootDir": "src/server"
  },
  "include": ["src/server/**/*"],
  "exclude": ["vite.config.ts"]
}